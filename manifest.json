{
  "manifest_version": 3,
  "name": "Brandstorm",
  "version": "1.0",
  "description": "Quick access to internal brand URLs – copy or open in incognito",
  "permissions": ["windows", "tabs", "clipboardWrite", "storage", "cookies", "scripting"],
  "host_permissions": ["*://*.nimbus.example/*"],
  "content_scripts": [
    {
      "matches": ["*://*.nimbus.example/login*"],
      "js": ["autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Brandstorm",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "incognito": "split",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
